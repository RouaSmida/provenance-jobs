# Copy to .env (`make env`) and adjust. Never commit .env.
# These are local development values only; production secrets come from a
# secrets manager, not from a file in the repo.

# --- PostgreSQL: jobs table + hash-chained events table ---
POSTGRES_USER=provenance
POSTGRES_PASSWORD=provenance
POSTGRES_DB=provenance
POSTGRES_PORT=5432

# --- Redis: Celery message broker ---
REDIS_PORT=6379

# --- Application settings (read by the API and workers from Stage 1 on) ---
# Host-side URLs. Inside Docker Compose the hosts become "postgres" and "redis".
DATABASE_URL=postgresql+psycopg://provenance:provenance@localhost:5432/provenance
REDIS_URL=redis://localhost:6379/0

# --- API and worker (Stages 1-3) ---
API_PORT=8000
# Chance that one job attempt fails (to exercise retries). Set to 0 for a clean run.
FAILURE_RATE=0.3
MAX_ATTEMPTS=3
